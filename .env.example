# Salin file ini menjadi .env, lalu isi nilainya.

# API ID dan API hash dari https://my.telegram.org
API_ID=
API_HASH=

# Token bot dari @BotFather
BOT_TOKEN=

# User ID Telegram kamu. Hanya user ini yang boleh memakai bot.
OWNER_ID=

# Opsional
# DOWNLOAD_DIR=~/leech
# STATS_FILE=leech_stats.json
